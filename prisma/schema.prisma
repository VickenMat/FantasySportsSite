generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  NFL
  MLB
  NBA
  NHL
}

enum LeagueFormat {
  DYNASTY
  REDRAFT
}

enum LeagueVisibility {
  PRIVATE
  PUBLIC
}

enum LeagueRole {
  COMMISSIONER
  MANAGER
}

enum LeagueStatus {
  SETUP
  DRAFTING
  ACTIVE
  COMPLETE
}

enum DraftStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETE
}

enum WaiverStatus {
  PENDING
  WON
  LOST
  REJECTED
  CANCELLED
}

enum MatchupStatus {
  SCHEDULED
  FINAL
}

enum TransactionType {
  DRAFT
  ADD
  DROP
  WAIVER
  COMMISSIONER
  TRADE
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TradeSide {
  PROPOSER
  RECIPIENT
}

model User {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   LeagueMember[]
  fantasyTeams  FantasyTeam[]
  invitations   LeagueInvitation[] @relation("InvitationCreator")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model League {
  id                  String               @id @default(uuid()) @db.Uuid
  slug                String               @unique
  name                String
  format              LeagueFormat
  visibility          LeagueVisibility     @default(PRIVATE)
  maxTeams            Int
  isDemo              Boolean              @default(false)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  members             LeagueMember[]
  sports              LeagueSport[]
  presetId            String               @db.Uuid
  preset              ScoringPreset        @relation(fields: [presetId], references: [id])
  primarySport        Sport?
  seasonYear          Int                  @default(2026)
  status              LeagueStatus         @default(SETUP)
  isHistorical        Boolean              @default(false)
  startingFaab        Int                  @default(100)
  rosterSlots         String[]             @default([])
  benchSlots          Int                  @default(5)
  draftRounds         Int                  @default(14)
  draftSecondsPerPick Int                  @default(90)
  currentPeriod       Int                  @default(0)
  playoffTeams        Int                  @default(4)
  playoffPeriods      Int                  @default(2)
  teams               FantasyTeam[]
  invitations         LeagueInvitation[]
  drafts              Draft[]
  periods             ScoringPeriod[]
  matchups            Matchup[]
  waiverClaims        WaiverClaim[]
  transactions        FantasyTransaction[]
  trades              Trade[]

  @@index([status, primarySport])
}

model LeagueMember {
  id          String       @id @default(uuid()) @db.Uuid
  leagueId    String       @db.Uuid
  userId      String       @db.Uuid
  role        LeagueRole   @default(MANAGER)
  joinedAt    DateTime     @default(now()) @db.Timestamptz(3)
  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fantasyTeam FantasyTeam?

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId, role])
}

model LeagueInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  leagueId    String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique
  email       String?
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leagueId, expiresAt])
}

model FantasyTeam {
  id             String               @id @default(uuid()) @db.Uuid
  leagueId       String               @db.Uuid
  managerId      String?              @db.Uuid
  membershipId   String?              @unique @db.Uuid
  name           String
  isComputer     Boolean              @default(false)
  draftSlot      Int?
  faabRemaining  Int
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  league         League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  manager        User?                @relation(fields: [managerId], references: [id], onDelete: Cascade)
  membership     LeagueMember?        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roster         RosterEntry[]
  sportRosters   FantasyRoster[]
  keepers        KeeperSelection[]
  picks          DraftPick[]
  queue          DraftQueueEntry[]
  homeMatchups   Matchup[]            @relation("HomeTeam")
  awayMatchups   Matchup[]            @relation("AwayTeam")
  waiverClaims   WaiverClaim[]
  transactions   FantasyTransaction[]
  proposedTrades Trade[]              @relation("TradeProposer")
  receivedTrades Trade[]              @relation("TradeRecipient")
  sourceTradeAssets      TradeAsset[] @relation("TradeAssetSourceTeam")
  destinationTradeAssets TradeAsset[] @relation("TradeAssetDestinationTeam")
  tradeCuts              TradeCut[]

  @@unique([leagueId, managerId])
  @@unique([leagueId, name])
  @@unique([leagueId, draftSlot])
  @@index([managerId])
  @@index([leagueId, isComputer])
}

model RosterEntry {
  id            String        @id @default(uuid()) @db.Uuid
  leagueId      String        @db.Uuid
  teamId        String        @db.Uuid
  playerId      String        @db.Uuid
  rosterId      String        @db.Uuid
  sport         Sport
  seasonId      String?       @db.Uuid
  slot          String
  acquiredAt    DateTime      @default(now()) @db.Timestamptz(3)
  releasedAt    DateTime?     @db.Timestamptz(3)
  lockedAt      DateTime?     @db.Timestamptz(3)
  team          FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fantasyRoster FantasyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  season        Season?       @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@index([leagueId, sport, playerId, releasedAt])
  @@index([rosterId, releasedAt, slot])
  @@index([teamId, sport, slot])
}

model Draft {
  id             String            @id @default(uuid()) @db.Uuid
  leagueId       String            @db.Uuid
  leagueSportId  String            @db.Uuid
  seasonId       String            @db.Uuid
  sport          Sport
  status         DraftStatus       @default(SCHEDULED)
  rounds         Int
  secondsPerPick Int               @default(90)
  currentPick    Int               @default(1)
  order          String[]
  pickOrder      String[]          @default([])
  startedAt      DateTime?         @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  pickStartedAt  DateTime?         @db.Timestamptz(3)
  pickDeadlineAt DateTime?         @db.Timestamptz(3)
  pausedAt       DateTime?         @db.Timestamptz(3)
  pausedRemainingMs Int?
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  league         League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport    LeagueSport       @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  season         Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  picks          DraftPick[]
  queue          DraftQueueEntry[]

  @@unique([leagueSportId, seasonId])
  @@index([leagueId, sport, status])
  @@index([status, pickDeadlineAt])
}

model DraftPick {
  id        String      @id @default(uuid()) @db.Uuid
  draftId   String      @db.Uuid
  teamId    String      @db.Uuid
  playerId  String      @db.Uuid
  overall   Int
  round     Int
  roundPick Int
  automatic Boolean     @default(false)
  pickedAt  DateTime    @default(now()) @db.Timestamptz(3)
  draft     Draft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team      FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([draftId, overall])
  @@unique([draftId, playerId])
  @@index([teamId])
}

model DraftQueueEntry {
  id        String      @id @default(uuid()) @db.Uuid
  draftId   String      @db.Uuid
  teamId    String      @db.Uuid
  playerId  String      @db.Uuid
  rank      Int
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  draft     Draft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team      FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, teamId, playerId])
  @@unique([draftId, teamId, rank])
}

model ScoringPeriod {
  id            String      @id @default(uuid()) @db.Uuid
  leagueId      String      @db.Uuid
  leagueSportId String      @db.Uuid
  sport         Sport
  number        Int
  startsAt      DateTime    @db.Timestamptz(3)
  endsAt        DateTime    @db.Timestamptz(3)
  finalizedAt   DateTime?   @db.Timestamptz(3)
  league        League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport   LeagueSport @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  matchups      Matchup[]

  @@unique([leagueId, sport, number])
  @@index([leagueSportId, number])
}

model Matchup {
  id           String        @id @default(uuid()) @db.Uuid
  leagueId     String        @db.Uuid
  sport        Sport
  periodId     String        @db.Uuid
  homeTeamId   String        @db.Uuid
  awayTeamId   String        @db.Uuid
  homeTenths   BigInt        @default(0)
  awayTenths   BigInt        @default(0)
  status       MatchupStatus @default(SCHEDULED)
  calculatedAt DateTime?     @db.Timestamptz(3)
  isPlayoff    Boolean       @default(false)
  playoffRound Int?
  league       League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  period       ScoringPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  homeTeam     FantasyTeam   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam     FantasyTeam   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  @@unique([periodId, homeTeamId])
  @@unique([periodId, awayTeamId])
  @@index([leagueId, sport, status])
  @@index([leagueId, isPlayoff, playoffRound])
}

model WaiverClaim {
  id            String        @id @default(uuid()) @db.Uuid
  leagueId      String        @db.Uuid
  leagueSportId String        @db.Uuid
  rosterId      String        @db.Uuid
  sport         Sport
  teamId        String        @db.Uuid
  addPlayerId   String        @db.Uuid
  dropPlayerId  String?       @db.Uuid
  bid           Int
  priority      Int
  processAt     DateTime      @db.Timestamptz(3)
  status        WaiverStatus  @default(PENDING)
  reason        String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?     @db.Timestamptz(3)
  league        League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport   LeagueSport   @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  fantasyRoster FantasyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  team          FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  addPlayer     Player        @relation("WaiverAdd", fields: [addPlayerId], references: [id], onDelete: Restrict)
  dropPlayer    Player?       @relation("WaiverDrop", fields: [dropPlayerId], references: [id], onDelete: Restrict)

  @@index([leagueId, sport, processAt, status])
  @@index([teamId, status])
}

model FantasyTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  leagueId        String          @db.Uuid
  leagueSportId   String          @db.Uuid
  rosterId        String          @db.Uuid
  sport           Sport
  teamId          String          @db.Uuid
  type            TransactionType
  playerId        String?         @db.Uuid
  relatedPlayerId String?         @db.Uuid
  amount          Int?
  note            String
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  league          League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport     LeagueSport     @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  fantasyRoster   FantasyRoster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  team            FantasyTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player          Player?         @relation("TransactionPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  relatedPlayer   Player?         @relation("TransactionRelatedPlayer", fields: [relatedPlayerId], references: [id], onDelete: Restrict)

  @@index([leagueId, sport, createdAt])
}

model Trade {
  id              String       @id @default(uuid()) @db.Uuid
  leagueId        String       @db.Uuid
  leagueSportId   String?      @db.Uuid
  sport           Sport?
  proposerTeamId  String       @db.Uuid
  recipientTeamId String       @db.Uuid
  status          TradeStatus  @default(PENDING)
  message         String?
  expiresAt       DateTime     @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  respondedAt     DateTime?    @db.Timestamptz(3)
  processedAt     DateTime?    @db.Timestamptz(3)
  league          League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport     LeagueSport? @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  proposerTeam    FantasyTeam  @relation("TradeProposer", fields: [proposerTeamId], references: [id], onDelete: Cascade)
  recipientTeam   FantasyTeam  @relation("TradeRecipient", fields: [recipientTeamId], references: [id], onDelete: Cascade)
  assets          TradeAsset[]
  cuts            TradeCut[]

  @@index([leagueId, status, createdAt])
  @@index([recipientTeamId, status])
  @@index([proposerTeamId, status])
}

model TradeAsset {
  id                String        @id @default(uuid()) @db.Uuid
  tradeId           String        @db.Uuid
  teamId            String        @db.Uuid
  destinationTeamId String        @db.Uuid
  sourceRosterId    String        @db.Uuid
  playerId          String        @db.Uuid
  sport             Sport
  side              TradeSide
  trade             Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  team              FantasyTeam   @relation("TradeAssetSourceTeam", fields: [teamId], references: [id], onDelete: Cascade)
  destinationTeam   FantasyTeam   @relation("TradeAssetDestinationTeam", fields: [destinationTeamId], references: [id], onDelete: Cascade)
  sourceRoster      FantasyRoster @relation(fields: [sourceRosterId], references: [id], onDelete: Restrict)
  player            Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tradeId, playerId])
  @@index([teamId, playerId])
  @@index([destinationTeamId, sport])
  @@index([sourceRosterId])
}

model TradeCut {
  id         String        @id @default(uuid()) @db.Uuid
  tradeId    String        @db.Uuid
  teamId     String        @db.Uuid
  rosterId   String        @db.Uuid
  playerId   String        @db.Uuid
  sport      Sport
  authorizedAt DateTime    @default(now()) @db.Timestamptz(3)
  processedAt  DateTime?   @db.Timestamptz(3)
  trade      Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  team       FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roster     FantasyRoster @relation(fields: [rosterId], references: [id], onDelete: Restrict)
  player     Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tradeId, playerId])
  @@index([teamId, sport])
  @@index([rosterId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model BackgroundJobRun {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  jobType     String
  status      String
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  result      Json?

  @@index([jobType, startedAt])
}

model LeagueSport {
  id                  String               @id @default(uuid()) @db.Uuid
  leagueId            String               @db.Uuid
  sport               Sport
  seasonId            String               @db.Uuid
  seasonLabel         String
  rosterSlots         String[]             @default([])
  benchSlots          Int                  @default(5)
  draftRounds         Int                  @default(14)
  draftOrder          String[]             @default([])
  draftSecondsPerPick Int                  @default(90)
  startingFaab        Int                  @default(100)
  keeperLimit         Int                  @default(0)
  keeperDeadline      DateTime?            @db.Timestamptz(3)
  league              League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season              Season               @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  rosters             FantasyRoster[]
  drafts              Draft[]
  periods             ScoringPeriod[]
  waiverClaims        WaiverClaim[]
  transactions        FantasyTransaction[]
  trades              Trade[]
  keepers             KeeperSelection[]

  @@unique([leagueId, sport])
  @@index([sport, seasonId])
}

model FantasyRoster {
  id            String               @id @default(uuid()) @db.Uuid
  leagueId      String               @db.Uuid
  leagueSportId String               @db.Uuid
  teamId        String               @db.Uuid
  sport         Sport
  faabRemaining Int
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  leagueSport   LeagueSport          @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  team          FantasyTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  entries       RosterEntry[]
  waiverClaims  WaiverClaim[]
  transactions  FantasyTransaction[]
  keepers       KeeperSelection[]
  tradeAssets   TradeAsset[]
  tradeCuts     TradeCut[]

  @@unique([teamId, leagueSportId])
  @@index([leagueId, sport])
}

model KeeperSelection {
  id            String        @id @default(uuid()) @db.Uuid
  leagueSportId String        @db.Uuid
  rosterId      String        @db.Uuid
  teamId        String        @db.Uuid
  playerId      String        @db.Uuid
  seasonId      String        @db.Uuid
  draftCost     Int?
  selectedAt    DateTime      @default(now()) @db.Timestamptz(3)
  retainedAt    DateTime?     @db.Timestamptz(3)
  leagueSport   LeagueSport   @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  fantasyRoster FantasyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  team          FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([leagueSportId, seasonId, playerId])
  @@index([rosterId, seasonId])
}

model ScoringPreset {
  id           String        @id @default(uuid()) @db.Uuid
  version      String        @unique
  name         String
  experimental Boolean
  leagues      League[]
  rules        ScoringRule[]
  scoreLedgers ScoreLedger[]
}

model ScoringRule {
  id            String        @id @default(uuid()) @db.Uuid
  presetId      String        @db.Uuid
  sport         Sport
  statKey       String
  coefficient   Decimal       @db.Decimal(8, 1)
  applicability String
  preset        ScoringPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, sport, statKey])
}

model Player {
  id                  String                   @id @default(uuid()) @db.Uuid
  sport               Sport
  displayName         String
  isDemo              Boolean                  @default(false)
  isSynthetic         Boolean                  @default(false)
  externalIds         PlayerExternalId[]
  gameStats           PlayerGameStat[]
  positions           PlayerPositionEvidence[]
  scoreLedgers        ScoreLedger[]
  rosterEntries       RosterEntry[]
  draftPicks          DraftPick[]
  draftQueues         DraftQueueEntry[]
  waiverAdds          WaiverClaim[]            @relation("WaiverAdd")
  waiverDrops         WaiverClaim[]            @relation("WaiverDrop")
  transactions        FantasyTransaction[]     @relation("TransactionPlayer")
  relatedTransactions FantasyTransaction[]     @relation("TransactionRelatedPlayer")
  tradeAssets         TradeAsset[]
  tradeCuts           TradeCut[]
  keeperSelections    KeeperSelection[]

  @@index([sport, displayName])
  @@index([isDemo, sport, displayName])
  @@index([isSynthetic, sport, displayName])
}

enum SeasonCoverage {
  UNVERIFIED
  COMPLETE
  PARTIAL
  QUARANTINED
}

enum GamePhase {
  REGULAR
  POSTSEASON
  PRESEASON
  UNKNOWN
}

enum GameSide {
  HOME
  AWAY
  UNKNOWN
}

enum GameStatRole {
  FOOTBALL
  HITTER
  PITCHER
  BASKETBALL
  SKATER
  GOALIE
}

enum PositionEvidenceKind {
  LISTED
  FIELDING
}

model Season {
  id               String                   @id @default(uuid()) @db.Uuid
  sport            Sport
  startYear        Int
  label            String
  coverage         SeasonCoverage           @default(UNVERIFIED)
  coverageReason   String?
  games            Game[]
  positions        PlayerPositionEvidence[]
  leagueSports     LeagueSport[]
  rosterEntries    RosterEntry[]
  keeperSelections KeeperSelection[]
  drafts           Draft[]

  @@unique([sport, startYear])
}

model PlayerExternalId {
  id         String @id @default(uuid()) @db.Uuid
  sport      Sport
  provider   String
  externalId String
  playerId   String @db.Uuid
  player     Player @relation(fields: [playerId], references: [id])

  @@unique([sport, provider, externalId])
  @@index([playerId])
}

model ProTeam {
  id          String           @id @default(uuid()) @db.Uuid
  sport       Sport
  provider    String
  externalId  String
  code        String?
  displayName String
  games       GameTeam[]
  gameStats   PlayerGameStat[]

  @@unique([sport, provider, externalId])
}

model Game {
  id           String                   @id @default(uuid()) @db.Uuid
  sport        Sport
  seasonId     String                   @db.Uuid
  provider     String
  externalId   String
  phase        GamePhase
  gameDate     DateTime?                @db.Date
  startsAt     DateTime?                @db.Timestamptz(3)
  week         Int?
  season       Season                   @relation(fields: [seasonId], references: [id])
  teams        GameTeam[]
  gameStats    PlayerGameStat[]
  positions    PlayerPositionEvidence[]
  scoreLedgers ScoreLedger[]

  @@unique([sport, provider, externalId])
  @@index([seasonId, gameDate])
}

model GameTeam {
  gameId String           @db.Uuid
  teamId String           @db.Uuid
  side   GameSide         @default(UNKNOWN)
  game   Game             @relation(fields: [gameId], references: [id])
  team   ProTeam          @relation(fields: [teamId], references: [id])
  stats  PlayerGameStat[]

  @@id([gameId, teamId])
  @@index([teamId, gameId])
}

model Position {
  id       String                   @id @default(uuid()) @db.Uuid
  sport    Sport
  code     String
  evidence PlayerPositionEvidence[]

  @@unique([sport, code])
}

model PlayerPositionEvidence {
  id          String               @id @default(uuid()) @db.Uuid
  playerId    String               @db.Uuid
  positionId  String               @db.Uuid
  seasonId    String               @db.Uuid
  gameId      String?              @db.Uuid
  kind        PositionEvidenceKind
  started     Boolean?
  effectiveAt DateTime             @db.Timestamptz(3)
  knownAt     DateTime             @db.Timestamptz(3)
  provider    String
  externalId  String
  player      Player               @relation(fields: [playerId], references: [id])
  position    Position             @relation(fields: [positionId], references: [id])
  season      Season               @relation(fields: [seasonId], references: [id])
  game        Game?                @relation(fields: [gameId], references: [id])

  @@unique([provider, externalId])
  @@index([playerId, seasonId, knownAt])
}

model ImportBatch {
  id               String           @id @default(uuid()) @db.Uuid
  sport            Sport
  provider         String
  contentHash      String
  sourceName       String
  importerVersion  String
  correctionReason String?
  importedAt       DateTime         @default(now()) @db.Timestamptz(3)
  summary          Json
  gameStats        PlayerGameStat[]

  @@unique([sport, provider, contentHash, importerVersion])
}

model PlayerGameStat {
  id                String             @id @default(uuid()) @db.Uuid
  gameId            String             @db.Uuid
  playerId          String             @db.Uuid
  teamId            String             @db.Uuid
  importBatchId     String             @db.Uuid
  provider          String
  role              GameStatRole
  revision          Int
  priorRevisionId   String?            @unique @db.Uuid
  contentHash       String
  sourceLine        Int
  observedPositions String[]
  normalized        Json
  raw               Json
  recordedAt        DateTime           @default(now()) @db.Timestamptz(3)
  sourceKnownAt     DateTime?          @db.Timestamptz(3)
  game              Game               @relation(fields: [gameId], references: [id])
  player            Player             @relation(fields: [playerId], references: [id])
  participatingTeam GameTeam           @relation(fields: [gameId, teamId], references: [gameId, teamId], onDelete: NoAction, onUpdate: NoAction, map: "PlayerGameStat_participating_team")
  team              ProTeam            @relation(fields: [teamId], references: [id])
  importBatch       ImportBatch        @relation(fields: [importBatchId], references: [id])
  priorRevision     PlayerGameStat?    @relation("GameStatRevisions", fields: [priorRevisionId], references: [id])
  nextRevision      PlayerGameStat?    @relation("GameStatRevisions")
  scoreEntries      ScoreLedgerEntry[]

  @@unique([gameId, playerId, provider, role, revision])
  @@unique([gameId, playerId, provider, role, contentHash])
  @@index([playerId, gameId])
  @@index([importBatchId])
}

model ScoreLedger {
  id       String             @id @default(uuid()) @db.Uuid
  gameId   String             @db.Uuid
  playerId String             @db.Uuid
  presetId String             @db.Uuid
  role     GameStatRole
  game     Game               @relation(fields: [gameId], references: [id])
  player   Player             @relation(fields: [playerId], references: [id])
  preset   ScoringPreset      @relation(fields: [presetId], references: [id])
  entries  ScoreLedgerEntry[]

  @@unique([gameId, playerId, presetId])
  @@index([playerId, gameId])
}

model ScoreLedgerEntry {
  id                    String            @id @default(uuid()) @db.Uuid
  ledgerId              String            @db.Uuid
  statId                String            @db.Uuid
  sequence              Int
  previousEntryId       String?           @unique @db.Uuid
  reason                String
  engineVersion         String
  ruleHash              String
  inputHash             String
  totalTenths           BigInt
  lineItems             Json
  missingStats          String[]
  teEligible            Boolean?
  teEligibilityOverride Boolean?
  calculatedAt          DateTime          @default(now()) @db.Timestamptz(3)
  ledger                ScoreLedger       @relation(fields: [ledgerId], references: [id])
  stat                  PlayerGameStat    @relation(fields: [statId], references: [id])
  previousEntry         ScoreLedgerEntry? @relation("LedgerHistory", fields: [previousEntryId], references: [id])
  nextEntry             ScoreLedgerEntry? @relation("LedgerHistory")

  @@unique([ledgerId, sequence])
  @@index([statId])
}
