model SeasonCalendarObservation {
  id                    String              @id @default(uuid()) @db.Uuid
  importBatchId         String              @db.Uuid
  seasonId              String              @db.Uuid
  firstGameDate         DateTime            @db.Date
  lastGameDate          DateTime            @db.Date
