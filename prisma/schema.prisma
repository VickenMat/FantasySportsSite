enum SeasonCoverage {
  UNVERIFIED
  COMPLETE
  PARTIAL
  QUARANTINED
}

enum GamePhase {
  REGULAR
  POSTSEASON
  PRESEASON
  UNKNOWN
}

enum GameSide {
  HOME
  AWAY
  UNKNOWN
}

enum ScheduleCrosswalkStatus {
  MATCHED
  UNRESOLVED
  AMBIGUOUS
}

enum GameStatRole {
  FOOTBALL
  HITTER
  PITCHER
  BASKETBALL
  SKATER
  GOALIE
}

enum PositionEvidenceKind {
  LISTED
  FIELDING
}

model Season {
  fantasyWindows FantasyWindowRevision[]
  draftPlans           DraftPlan[]
  id                   String                               @id @default(uuid()) @db.Uuid
  sport                Sport
  startYear            Int
  label                String
  coverage             SeasonCoverage                       @default(UNVERIFIED)
  coverageReason       String?
  games                Game[]
  positions            PlayerPositionEvidence[]
  leagueSports         LeagueSport[]
  rosterEntries        RosterEntry[]
  keeperSelections     KeeperSelection[]
  drafts               Draft[]
  scheduleRevisions    ProfessionalSeasonScheduleRevision[]
  leagueAssignments    LeagueSportSeason[]
  calendarObservations SeasonCalendarObservation[]
  teamObservations     ProTeamSeasonObservation[]
  rookieEvidence       RookieEligibilityEvidence[]

  @@unique([sport, startYear])
}

model RookieEligibilityEvidence {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId     String   @db.Uuid
  seasonId     String   @db.Uuid
