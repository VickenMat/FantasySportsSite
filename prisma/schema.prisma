  game         Game?                         @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([playerId, effectiveAt, knownAt])
  @@index([gameId, knownAt])
}

model GameCompletionEvidence {
