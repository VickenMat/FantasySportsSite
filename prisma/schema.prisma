generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  NFL
  MLB
  NBA
  NHL
}

enum LeagueFormat {
  DYNASTY
  REDRAFT
}

enum CompetitionType {
  HEAD_TO_HEAD
  CUMULATIVE
}

enum ScheduleDataStatus {
  PENDING_DATA
  AVAILABLE
  INCOMPLETE
  UNAVAILABLE
}

enum ChampionshipCycleStatus {
  PLANNING
  ACTIVE
  COMPLETE
}

enum LeagueSportSeasonStatus {
  PENDING_DATA
  PENDING_CONFIGURATION
  ELIGIBLE
  DRAFTING
  ACTIVE
  COMPLETE
  ROLLED_OVER
}

enum LeagueVisibility {
  PRIVATE
  PUBLIC
}

enum LeagueRole {
  COMMISSIONER
  MANAGER
}

enum LeagueStatus {
  SETUP
  DRAFTING
  ACTIVE
  COMPLETE
}

enum DraftStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETE
}

enum DraftKind {
  INITIAL
  ROOKIE
}

enum WaiverStatus {
  PENDING
  WON
  LOST
  REJECTED
  CANCELLED
}

enum WaiverMethod {
  ROLLING
  FAAB
}

enum FaabScope {
  SPORT
  UNIVERSAL
}

enum FaabLedgerType {
  OPENING
  RESERVATION
  RESERVATION_RELEASE
  SETTLEMENT
  RESET
  TRADE
  AWARD
}

enum MatchupStatus {
  SCHEDULED
  FINAL
  SKIPPED
}

enum CompetitiveState {
  PENDING_DATA
  UPCOMING
  ACTIVE
  PROVISIONAL
  FINALIZED
}

enum CompetitionPeriodType {
  REGULAR
  PLAYOFF
  CONSOLATION
}

enum ChampionshipAwardType {
  BASE_PLACEMENT
  PLAYOFF_QUALIFICATION
  SPORT_CHAMPION
  SPORT_RUNNER_UP
  SPORT_THIRD_PLACE
  HIGHEST_REGULAR_PF
  LOWEST_REGULAR_PF
}

enum TransactionType {
  DRAFT
  ADD
  DROP
  WAIVER
  COMMISSIONER
  TRADE
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TradeSide {
  PROPOSER
  RECIPIENT
}

enum PlayerAvailabilityDesignation {
  ACTIVE
  QUESTIONABLE
  DOUBTFUL
  OUT
  INJURED_RESERVE
  SUSPENDED
  RETIRED
  UNKNOWN
}

enum RosterComplianceState {
  COMPLIANT
  PENDING_DATA
  IR_INELIGIBLE
  OVER_CAPACITY
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  sessions               Session[]
  accounts               Account[]
  memberships            LeagueMember[]
  fantasyTeams           FantasyTeam[]
  invitations            LeagueInvitation[]      @relation("InvitationCreator")
  rosterAssignmentEvents RosterAssignmentEvent[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model League {
  advancedProposals TradeProposal[]
  tradingPolicy TradeReviewPolicy?
  financePolicy             LeagueFinancePolicy?
  financeAccounts           FinanceAccount[]
  salaries                  PlayerSalary[]
  releaseFloors             ReleasedPlayerFloor[]
  acquisitionAuctions       AcquisitionAuction[]
  draftPlans                DraftPlan[]
  id                        String                       @id @default(uuid()) @db.Uuid
  slug                      String                       @unique
  name                      String
  format                    LeagueFormat
  competitionType           CompetitionType              @default(HEAD_TO_HEAD)
  visibility                LeagueVisibility             @default(PRIVATE)
  maxTeams                  Int
  isDemo                    Boolean                      @default(false)
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(3)
  members                   LeagueMember[]
  sports                    LeagueSport[]
  presetId                  String                       @db.Uuid
  preset                    ScoringPreset                @relation(fields: [presetId], references: [id])
  primarySport              Sport?
  seasonYear                Int                          @default(2026)
  status                    LeagueStatus                 @default(SETUP)
  isHistorical              Boolean                      @default(false)
  startingFaab              Int                          @default(100)
  waiverMethod              WaiverMethod                 @default(FAAB)
  faabScope                 FaabScope                    @default(SPORT)
  universalStartingFaab     Int                          @default(500)
  rosterSlots               String[]                     @default([])
  benchSlots                Int                          @default(5)
  universalBenchSlots       Int                          @default(5)
  universalIrSlots          Int                          @default(5)
  draftRounds               Int                          @default(14)
  draftSecondsPerPick       Int                          @default(90)
  currentPeriod             Int                          @default(0)
  playoffTeams              Int                          @default(4)
  playoffPeriods            Int                          @default(2)
  teams                     FantasyTeam[]
  invitations               LeagueInvitation[]
  drafts                    Draft[]
  periods                   ScoringPeriod[]
  matchups                  Matchup[]
  waiverClaims              WaiverClaim[]
  transactions              FantasyTransaction[]
  trades                    Trade[]
  championshipCycles        ChampionshipCycle[]
  gameAssignments           LeagueGameAssignment[]
  competitionConfigs        CompetitionConfigSnapshot[]
  sportCompetitions         SportCompetition[]
  tiebreakerEvents          CompetitiveTiebreakerEvent[]
  rosterAssignmentEvents    RosterAssignmentEvent[]
  lineupSnapshots           GameLineupSnapshot[]
  rosterComplianceSnapshots RosterComplianceSnapshot[]
  commissionerAuditEvents   CommissionerAuditEvent[]
  faabAccounts              FaabAccount[]
  waiverPriorities          WaiverPriority[]
  relativeMatchupPeriods    RelativeMatchupPeriod[]

  @@index([status, primarySport])
}

model CommissionerAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueId    String   @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  targetType  String
  targetId    String   @db.Uuid
  sport       Sport?
  before      Json
  after       Json
  reason      String
  effectiveAt DateTime @default(now()) @db.Timestamptz(3)
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, effectiveAt])
}

model LeagueMember {
  id          String       @id @default(uuid()) @db.Uuid
  leagueId    String       @db.Uuid
  userId      String       @db.Uuid
  role        LeagueRole   @default(MANAGER)
  joinedAt    DateTime     @default(now()) @db.Timestamptz(3)
  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fantasyTeam FantasyTeam?

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId, role])
}

model LeagueInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  leagueId    String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique
  email       String?
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  league      League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([leagueId, expiresAt])
}

model FantasyTeam {
  financeAccounts           FinanceAccount[]
  salaries                  PlayerSalary[]
  nominations               AcquisitionAuction[]
  acquisitionBids           AcquisitionBid[]
  id                        String                       @id @default(uuid()) @db.Uuid
  leagueId                  String                       @db.Uuid
  managerId                 String?                      @db.Uuid
  membershipId              String?                      @unique @db.Uuid
  name                      String
  isComputer                Boolean                      @default(false)
  draftSlot                 Int?
  faabRemaining             Int
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(3)
  league                    League                       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  manager                   User?                        @relation(fields: [managerId], references: [id], onDelete: Cascade)
  membership                LeagueMember?                @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roster                    RosterEntry[]
  sportRosters              FantasyRoster[]
  keepers                   KeeperSelection[]
  picks                     DraftPick[]
  queue                     DraftQueueEntry[]
  homeMatchups              Matchup[]                    @relation("HomeTeam")
  awayMatchups              Matchup[]                    @relation("AwayTeam")
  waiverClaims              WaiverClaim[]
  transactions              FantasyTransaction[]
  proposedTrades            Trade[]                      @relation("TradeProposer")
  receivedTrades            Trade[]                      @relation("TradeRecipient")
  sourceTradeAssets         TradeAsset[]                 @relation("TradeAssetSourceTeam")
  destinationTradeAssets    TradeAsset[]                 @relation("TradeAssetDestinationTeam")
  tradeCuts                 TradeCut[]
  sportPlacements           SportFinalPlacement[]
  championshipAwards        ChampionshipPointAward[]
  championshipResults       ChampionshipResult[]
  tiebreakerEvents          CompetitiveTiebreakerEvent[]
  rosterAssignmentEvents    RosterAssignmentEvent[]
  lineupSnapshots           GameLineupSnapshot[]
  rosterComplianceSnapshots RosterComplianceSnapshot[]
  originalFuturePicks       FutureDraftPick[]            @relation("OriginalFuturePickTeam")
  ownedFuturePicks          FutureDraftPick[]            @relation("CurrentFuturePickOwner")
  futurePickOwnership       FutureDraftPickOwnership[]
  faabAccounts              FaabAccount[]
  waiverPriorities          WaiverPriority[]
  relativeHomeMatchups      RelativeMatchup[]            @relation("RelativeHomeTeam")
  relativeAwayMatchups      RelativeMatchup[]            @relation("RelativeAwayTeam")

  @@unique([leagueId, managerId])
  @@unique([leagueId, name])
  @@unique([leagueId, draftSlot])
  @@index([managerId])
  @@index([leagueId, isComputer])
}

model RosterEntry {
  id               String                  @id @default(uuid()) @db.Uuid
  leagueId         String                  @db.Uuid
  teamId           String                  @db.Uuid
  playerId         String                  @db.Uuid
  rosterId         String                  @db.Uuid
  sport            Sport
  seasonId         String?                 @db.Uuid
  slot             String
  slotIndex        Int                     @default(1)
  acquiredAt       DateTime                @default(now()) @db.Timestamptz(3)
  releasedAt       DateTime?               @db.Timestamptz(3)
  lockedAt         DateTime?               @db.Timestamptz(3)
  team             FantasyTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fantasyRoster    FantasyRoster           @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player           Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  season           Season?                 @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  assignmentEvents RosterAssignmentEvent[]
  lineupSnapshots  GameLineupSnapshot[]

  @@index([leagueId, sport, playerId, releasedAt])
  @@index([rosterId, releasedAt, slot])
  @@index([teamId, sport, slot])
}

model RosterAssignmentEvent {
  id             String      @id @default(uuid()) @db.Uuid
  leagueId       String      @db.Uuid
  teamId         String      @db.Uuid
  rosterEntryId  String      @db.Uuid
  actorUserId    String?     @db.Uuid
  fromSlot       String?
  fromSlotIndex  Int?
  toSlot         String
  toSlotIndex    Int
  effectiveAt    DateTime    @db.Timestamptz(3)
  reason         String
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  league         League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team           FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rosterEntry    RosterEntry @relation(fields: [rosterEntryId], references: [id], onDelete: Cascade)
  actor          User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rosterEntryId, effectiveAt, createdAt])
  @@index([teamId, effectiveAt])
}

model RosterComplianceSnapshot {
  id          String                @id @default(uuid()) @db.Uuid
  leagueId    String                @db.Uuid
  teamId      String                @db.Uuid
  state       RosterComplianceState
  reasons     String[]
  sourceHash  String
  evaluatedAt DateTime              @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  league      League                @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team        FantasyTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, sourceHash])
  @@index([leagueId, teamId, evaluatedAt])
}

model LeagueFinancePolicy {
  leagueId    String @id @db.Uuid
  salaryMode  Boolean
  scope       String
  amount      Int
  league      League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id            String @id @default(uuid()) @db.Uuid
  leagueId      String @db.Uuid
  teamId        String @db.Uuid
  leagueSportId String? @db.Uuid
  seasonId      String? @db.Uuid
  cycleId       String? @db.Uuid
  kind          String
  scopeKey      String
  baseCap       Int
  capAdjustment Int @default(0)
  payroll       Int @default(0)
  deadCap       Int @default(0)
  reserved      Int @default(0)
  status        String @default("ACTIVE")
  league        League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team          FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leagueSport   LeagueSport? @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  ledger        FinanceLedgerEntry[]
  salaries      PlayerSalary[]
  obligations   DeadCapObligation[]
  bids          AcquisitionBid[]
  @@unique([teamId, kind, scopeKey])
  @@index([leagueId, scopeKey])
}

model FinanceLedgerEntry {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @db.Uuid
  type           String
  capDelta       Int @default(0)
  payrollDelta   Int @default(0)
  deadDelta      Int @default(0)
  reservedDelta  Int @default(0)
  availableAfter Int
  idempotencyKey String @unique
  actorUserId    String? @db.Uuid
  metadata       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  account        FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, createdAt])
}

model PlayerSalary {
  id        String @id @default(uuid()) @db.Uuid
  leagueId  String @db.Uuid
  playerId  String @db.Uuid
  teamId    String @db.Uuid
  accountId String @db.Uuid
  amount    Int
  active    Boolean @default(true)
  version   Int @default(1)
  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  team      FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([leagueId, playerId])
  @@index([teamId, active])
}

model DeadCapObligation {
  id             String @id @default(uuid()) @db.Uuid
  accountId      String @db.Uuid
  playerId       String @db.Uuid
  amount         Int
  releaseSalary  Int
  releasedAt     DateTime @db.Timestamptz(3)
  clearedAt      DateTime? @db.Timestamptz(3)
  account        FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  player         Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@index([accountId, playerId, releasedAt])
}

model ReleasedPlayerFloor {
  id        String @id @default(uuid()) @db.Uuid
  leagueId  String @db.Uuid
  playerId  String @db.Uuid
  amount    Int
  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([leagueId, playerId])
}

model AcquisitionAuction {
  id              String @id @default(uuid()) @db.Uuid
  leagueId        String @db.Uuid
  leagueSportId   String @db.Uuid
  playerId        String @db.Uuid
  nominatorTeamId String @db.Uuid
  draftId         String? @db.Uuid
  mode            String
  priority        String[] @default([])
  status          String @default("OPEN")
  minimum         Int
  opensAt         DateTime @db.Timestamptz(3)
  closesAt        DateTime @db.Timestamptz(3)
  winnerTeamId    String? @db.Uuid
  price           Int?
  settledAt       DateTime? @db.Timestamptz(3)
  league          League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport     LeagueSport @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  player          Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  nominator       FantasyTeam @relation(fields: [nominatorTeamId], references: [id], onDelete: Cascade)
  draft           Draft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  bids            AcquisitionBid[]
  @@index([status, closesAt])
}

model AcquisitionBid {
  id          String @id @default(uuid()) @db.Uuid
  auctionId   String @db.Uuid
  teamId      String @db.Uuid
  accountId   String @db.Uuid
  maximum     Int
  reservation Int
  tieRank     Int
  version     Int @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  auction     AcquisitionAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  team        FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account     FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([auctionId, teamId])
}

model DraftPlan {
  id            String      @id @default(uuid()) @db.Uuid
  leagueId      String      @db.Uuid
  leagueSportId String      @db.Uuid
  seasonId      String      @db.Uuid
  draftId       String?     @unique @db.Uuid
  kind          DraftKind   @default(INITIAL)
  method        String      @default("SNAKE")
  scope         String      @default("SPORT")
  orderMethod   String      @default("CUSTOM")
  order         String[]
  rounds        Int
  secondsPerPick Int        @default(90)
  scheduledAt   DateTime?   @db.Timestamptz(3)
  timezone      String      @default("UTC")
  status        String      @default("UNSCHEDULED")
  blockedReason String?
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  league        League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport   LeagueSport @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  draft         Draft?      @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@unique([leagueSportId, seasonId, kind])
  @@index([status, scheduledAt])
}

model Draft {
  auctions          AcquisitionAuction[]
  plan              DraftPlan?
  id                String            @id @default(uuid()) @db.Uuid
  leagueId          String            @db.Uuid
  leagueSportId     String            @db.Uuid
  seasonId          String            @db.Uuid
  sport             Sport
  kind              DraftKind         @default(INITIAL)
  orderProvenance   String?
  status            DraftStatus       @default(SCHEDULED)
  rounds            Int
  secondsPerPick    Int               @default(90)
  currentPick       Int               @default(1)
  order             String[]
  pickOrder         String[]          @default([])
  startedAt         DateTime?         @db.Timestamptz(3)
  completedAt       DateTime?         @db.Timestamptz(3)
  pickStartedAt     DateTime?         @db.Timestamptz(3)
  pickDeadlineAt    DateTime?         @db.Timestamptz(3)
  pausedAt          DateTime?         @db.Timestamptz(3)
  pausedRemainingMs Int?
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  league            League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSport       LeagueSport       @relation(fields: [leagueSportId], references: [id], onDelete: Cascade)
  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  picks             DraftPick[]
  queue             DraftQueueEntry[]

  @@unique([leagueSportId, seasonId, kind])
  @@index([leagueId, sport, status])
  @@index([status, pickDeadlineAt])
}

model DraftPick {
  id        String      @id @default(uuid()) @db.Uuid
  draftId   String      @db.Uuid
  teamId    String      @db.Uuid
  playerId  String      @db.Uuid
  overall   Int
  round     Int
  roundPick Int
  automatic Boolean     @default(false)
  pickedAt  DateTime    @default(now()) @db.Timestamptz(3)
  draft     Draft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team      FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  recap     DraftSelectionSnapshot?

  @@unique([draftId, overall])
  @@unique([draftId, playerId])
  @@index([teamId])
}

model DraftSelectionSnapshot {
  pickId            String @id @db.Uuid
  playerName        String
  franchiseName     String
  originalTeamId    String @db.Uuid
  originalTeamName  String
  sport             Sport
  positions         String[]
  price             Int?
  method            String
  capturedAt        DateTime @default(now()) @db.Timestamptz(3)
  pick              DraftPick @relation(fields: [pickId], references: [id], onDelete: Cascade)
}

model TradeProposal {
  id String @id @default(uuid()) @db.Uuid
  leagueId String @db.Uuid
  proposerTeamId String @db.Uuid
  participantIds String[]
  currentRevision Int @default(1)
  status String @default("PENDING")
  reviewHours Int @default(24)
  executeAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revisions TradeProposalRevision[]
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  @@index([leagueId, status])
  @@index([status, executeAt])
}

model TradeProposalRevision {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  version Int
  assets Json
  actorUserId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  proposal TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  acceptances TradeProposalAcceptance[]
  @@unique([proposalId, version])
}

model TradeProposalAcceptance {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @db.Uuid
  teamId String @db.Uuid
  actorUserId String
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  revision TradeProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  @@unique([revisionId, teamId])
}

model TradeReviewPolicy {
  leagueId String @id @db.Uuid
  reviewHours Int @default(24)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model FantasyWindowRevision {
