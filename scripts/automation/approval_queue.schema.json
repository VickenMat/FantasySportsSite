{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-maintained exact-target approval audit queue",
  "type": "object",
  "required": ["version", "approvals"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}
  },
  "$defs": {
    "sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "approval": {
      "type": "object",
      "required": ["id", "exact_proposed_action", "why_approval_required", "alternatives", "recommendation", "expected_consequences", "affected_resources", "target_fingerprint", "task_fingerprint", "scope", "expires_at", "status", "decision"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "exact_proposed_action": {"type": "string", "minLength": 1},
        "why_approval_required": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recommendation": {"type": "string"},
        "expected_consequences": {"type": "string"},
        "affected_resources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "target_fingerprint": {"$ref": "#/$defs/sha"},
        "task_fingerprint": {"$ref": "#/$defs/sha"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["pending", "approved", "rejected", "expired", "withdrawn"]},
        "decision": {"type": ["object", "null"], "properties": {"actor_kind": {"const": "human"}, "actor": {"const": "project_owner"}, "recorded_at": {"type": "string", "format": "date-time"}, "source_reference": {"type": "string"}}, "required": ["actor_kind", "actor", "recorded_at"], "additionalProperties": false}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "approved"}}}, "then": {"properties": {"target_fingerprint": {"type": "string"}, "task_fingerprint": {"type": "string"}, "expires_at": {"type": "string"}, "decision": {"type": "object"}}}}]
    }
  },
  "$comment": "This is an audit schema, not cryptographic human authentication. Agents have no approval command. Runtime exact-target/expiry checks remain mandatory."
}
