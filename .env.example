# Local Compose database. Set unique credentials outside local development.
POSTGRES_DB=fantasy_evolution
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy_local
POSTGRES_PORT=5432
DEVELOPMENT_DATABASE_URL=postgresql://fantasy:fantasy_local@127.0.0.1:5432/fantasy_evolution
DATABASE_URL=postgresql://fantasy:fantasy_local@127.0.0.1:5432/fantasy_evolution
# Automated commands replace DATABASE_URL with this value and reject any database not explicitly allowlisted.
TEST_DATABASE_URL=postgresql://fantasy:fantasy_local@127.0.0.1:5432/fantasy_evolution_test
AUTHORIZED_TEST_DATABASES=fantasy_evolution_test
# Configure only in the production environment; never point tests at this database.
PRODUCTION_DATABASE_URL=
DATABASE_POOL_MAX=10
# Canonical local URL. Better Auth also explicitly trusts http://127.0.0.1:3000 in local development.
AUTH_URL=http://localhost:3000
# Dedicated browser-test server; Playwright refuses to reuse an existing process.
TEST_AUTH_URL=http://localhost:3100
# Generate a value with: openssl rand -base64 32
AUTH_SECRET=

# Optional local demo credentials. The seed skips demo account creation without a password.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=

# Compose runs a local Mailpit SMTP inbox at http://127.0.0.1:8025.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Fantasy Evolution <no-reply@example.test>
# CI gets an isolated Mailpit container. Local test messages may use a separate test SMTP endpoint.
TEST_SMTP_URL=smtp://127.0.0.1:1025
TEST_MAIL_FROM=Fantasy Evolution Tests <tests@example.test>

# Future ingestion adapters may use provider credentials.
SPORTS_PROVIDER_API_KEY=
