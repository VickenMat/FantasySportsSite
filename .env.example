# Local Compose database. Set unique credentials outside local development.
POSTGRES_DB=fantasy_evolution
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fantasy:fantasy_local@127.0.0.1:5432/fantasy_evolution
AUTH_URL=http://127.0.0.1:3000
# Generate a value with: openssl rand -base64 32
AUTH_SECRET=

# Optional local demo credentials. The seed skips demo account creation without a password.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=

# Compose runs a local Mailpit SMTP inbox at http://127.0.0.1:8025.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Fantasy Evolution <no-reply@example.test>

# Future ingestion adapters may use provider credentials.
SPORTS_PROVIDER_API_KEY=
