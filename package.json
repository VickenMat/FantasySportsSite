{
  "name": "fantasy-evolution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db:prepare": "node scripts/run-in-test-environment.mjs --prepare",
    "test:integration": "node scripts/run-in-test-environment.mjs -- npx vitest run tests/integration",
    "test:e2e": "node scripts/run-in-test-environment.mjs -- npx playwright test",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/workers/index.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:import": "tsx --env-file-if-exists=.env src/workers/import-csv.ts",
    "score:recalculate": "tsx --env-file-if-exists=.env src/workers/recalculate-score.ts",
    "simulate": "tsx src/workers/simulate.ts",
    "data:audit": "tsx --env-file-if-exists=.env src/workers/audit-parquet.ts",
    "data:count-current-pools": "tsx src/workers/count-current-pools.ts",
    "db:import:parquet": "tsx --env-file-if-exists=.env src/workers/import-parquet.ts",
    "db:import:schedules": "tsx --env-file-if-exists=.env src/workers/import-professional-schedules.ts",
    "db:import:schedule-parquet": "tsx --env-file-if-exists=.env src/workers/import-schedule-parquet.ts",
    "fantasy:process": "tsx --env-file-if-exists=.env src/workers/process-fantasy.ts",
    "fantasy:draft-timer": "tsx --env-file-if-exists=.env src/workers/draft-timer.ts",
    "test:load": "node scripts/run-in-test-environment.mjs -- npx tsx src/workers/load-test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.27",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "csv-parse": "7.0.3",
    "dotenv": "^17",
    "hyparquet": "^1.33.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "^8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "hyparquet-writer": "^0.18.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
