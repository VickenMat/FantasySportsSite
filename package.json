{
  "name": "fantasy-evolution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/workers/index.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:import": "tsx --env-file-if-exists=.env src/workers/import-csv.ts",
    "score:recalculate": "tsx --env-file-if-exists=.env src/workers/recalculate-score.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.27",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "csv-parse": "^6.2.1",
    "dotenv": "^17",
    "lucide-react": "^0.577.0",
    "next": "16.2.10",
    "nodemailer": "^8",
    "pg": "^8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module"
}
